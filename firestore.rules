rules_version = '2';

// This now mirrors the real production rules (previously only set via the
// Firebase Console, never tracked here — see PROJECT_HANDOFF.md's
// 2026-09-17 entries). The `donations/{uid}` block is new: read-only for
// the owning signed-in user, never client-writable — populated only by
// stripeWebhook via the Admin SDK, which bypasses these rules entirely.
// `stripeSubscriptions/{id}` (the webhook's own renewal-lookup mapping)
// intentionally has no rule at all — no client ever needs it, and an
// unmatched path defaults to deny.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /stats/global {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['totalTalksRead'])
        && request.resource.data.totalTalksRead ==
           (resource == null ? 0 : resource.data.totalTalksRead) + 1;
    }
    // Aggregate ledger stats only (counts, no per-user data) — written
    // solely by the ledgerStats* functions via the Admin SDK.
    match /stats/ledger {
      allow read: if true;
      allow write: if false;
    }
    match /donations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Idea 57 — shared lists. Members can read; nobody writes directly.
    // Every change goes through the shared-list callables in
    // functions/index.js (Admin SDK), so "Added by" can't be forged and
    // concurrent edits are transactional.
    match /sharedLists/{listId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }
    match /sharedListIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Invite codes are secrets; only the functions ever read them.
    match /sharedListInvites/{code} {
      allow read, write: if false;
    }
  }
}
