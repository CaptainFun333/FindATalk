rules_version = '2';

// Local-emulator-only rules file for testing the stripeWebhook function.
// Not deployed to production Firestore — deploys in this repo only ever
// target `--only functions`. A real audit of the existing client-side
// Auth/Firestore sync rules is still outstanding (see PROJECT_HANDOFF.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
