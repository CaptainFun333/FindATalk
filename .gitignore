research/

# Firebase Cloud Functions (functions/) local state — node_modules/ above
# already covers functions/node_modules/.
functions/.runtimeconfig.json
functions/.secret.local
functions/.env*

# Firebase CLI local deploy cache and local emulator debug log.
.firebase/
firestore-debug.log
ui-debug.log
