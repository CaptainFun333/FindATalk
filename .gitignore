.DS_Store
node_modules/
talktest

# Xcode/SPM local build state generated when resolving a local Swift
# package (e.g. packages/capacitor-streak-bridge) outside ios/ — ios/
# has its own xcuserdata rule already, but this covers local packages
# living elsewhere in the repo too.
.swiftpm/
xcuserdata/

