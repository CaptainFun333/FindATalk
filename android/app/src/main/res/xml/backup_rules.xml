<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules for API 23-30 devices (below Android 12, which
  reads data_extraction_rules.xml instead — see that file's comment for
  why this exists and what it needs to cover: the WebView's storage
  directory, `app_webview/`, where Favorites and My Lists are persisted).
-->
<full-backup-content>
    <include domain="file" path="app_webview/" />
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
</full-backup-content>
