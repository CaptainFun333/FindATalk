<?xml version="1.0" encoding="utf-8"?>
<!-- Rose-palette counterpart of widget_background_light.xml, for when the
     person picked "Rose" in Settings' Color Palette. Literal hex values
     for the same reason as widget_background_light.xml — must match
     docs/index.html's :root[data-palette="rose"] paper-raised/line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FBECE8" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#E0B7BA" />
</shape>
