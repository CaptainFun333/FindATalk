<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit-override counterpart of widget_background.xml, for when the
     person picked "Light" with the in-app toggle rather than following
     the system setting. Uses literal hex values instead of @color/
     references on purpose: a resource reference re-resolves against
     whatever the CURRENT device night mode is when the widget host
     renders it, which is exactly the auto-follow-system behavior an
     explicit choice needs to override. Must match values/colors.xml's
     widget_paper_raised/widget_line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FAF7EE" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#C9BFA2" />
</shape>
