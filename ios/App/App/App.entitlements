<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.captainfun333.findatalk</string>
	</array>
	<!-- Universal Links (idea 40, part 2): pairs with docs/.well-known/
	     apple-app-site-association on findatalk.com. iOS fetches and
	     verifies that file at install time; on a match, tapping a
	     findatalk.com link opens the app directly instead of Safari — with
	     no build-time way to fail loudly if the AASA file is ever wrong,
	     so verifying it live (Apple's own validator, or just installing a
	     real build and tapping a real link) matters more than usual here. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:findatalk.com</string>
		<string>applinks:www.findatalk.com</string>
	</array>
</dict>
</plist>
