{
	"appId": "com.captainfun333.findatalk",
	"appName": "FindATalk",
	"webDir": "docs",
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"apple.com",
				"google.com"
			]
		}
	},
	"experimental": {
		"ios": {
			"spm": {
				"packageOptions": {
					"@capacitor-firebase/app": {
						"symlink": true
					}
				}
			}
		}
	},
	"packageClassList": [
		"InAppReviewPlugin",
		"FirebaseAppPlugin",
		"FirebaseAuthenticationPlugin",
		"FirebaseFirestorePlugin",
		"FirebaseFunctionsPlugin",
		"AppPlugin",
		"FilesystemPlugin",
		"LocalNotificationsPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"IAPBridgePlugin",
		"StreakBridgePlugin"
	]
}
